{
  "name": "apex-commons",
  "version": "0.11.0",
  "type": "module",
  "description": "Shared utilities for ApexCharts products (licensing, watermark, motion).",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/apexcharts/projects",
    "directory": "libs/commons"
  },
  "main": "./apex-commons.min.js",
  "module": "./apex-commons.es.min.js",
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "ignite-ui/css": [
        "./ignite-ui-css.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./apex-commons.ignite-ui.es.min.js",
    "./apex-commons.ignite-ui.min.js",
    "./apex-commons.ignite-ui.min.cjs",
    "./src/ignite-ui.ts",
    "./css/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./apex-commons.es.min.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./apex-commons.min.cjs"
      }
    },
    "./ignite-ui": {
      "import": {
        "types": "./ignite-ui.d.ts",
        "default": "./apex-commons.ignite-ui.es.min.js"
      },
      "require": {
        "types": "./ignite-ui.d.ts",
        "default": "./apex-commons.ignite-ui.min.cjs"
      }
    },
    "./ignite-ui/css": {
      "types": "./ignite-ui-css.d.ts",
      "default": "./apex-commons.ignite-ui-css.es.min.js"
    },
    "./css/*": "./css/*",
    "./i18n": {
      "import": {
        "types": "./i18n.d.ts",
        "default": "./i18n.es.min.js"
      },
      "require": {
        "types": "./i18n.d.ts",
        "default": "./i18n.cjs"
      }
    }
  }
}
